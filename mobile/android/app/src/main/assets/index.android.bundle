__d(function(g,r,i,a,m,_e,d){"use strict";Object.defineProperty(_e,'__esModule',{value:!0}),Object.defineProperty(_e,"default",{enumerable:!0,get:function(){return h}});var e,t=r(d[0]),o=r(d[1]),n=r(d[2]),s=r(d[3]),c=r(d[4]),l=(e=c)&&e.__esModule?e:{default:e},u=r(d[5]),p=[{category:'Account & Security',icon:n.Lock,items:[{id:'sec-1',question:'How is my account secured?',answer:'TushuDiary protects your account using bcrypt password hashing on our authentication servers and JWT (JSON Web Tokens) for API communication. On your local device, App Lock PINs are secured with salted SHA-256 cryptographic hashing in secure device storage.'},{id:'sec-2',question:'How do I set up or change my App Lock PIN?',answer:'Navigate to Settings > App Lock. Enter your desired 4-digit PIN and confirm it. You can also enable Biometric Unlock (Face ID or Fingerprint) to quickly authenticate without typing your PIN every time.'},{id:'sec-3',question:'How do I change my password?',answer:'Go to Settings > Change Password (under Privacy & Security). You will be required to verify your current password before setting a new secure password.'},{id:'sec-4',question:'What happens when I log out?',answer:'When you log out, your active authentication tokens and runtime cached credentials are systematically purged from device memory and AsyncStorage, preventing unauthorized session resumption.'}]},{category:'Privacy & Data Isolation',icon:n.ShieldCheck,items:[{id:'priv-1',question:'Can another user on my device see my records?',answer:'No. TushuDiary enforces strict user data isolation. All local records, keys, and preferences are scoped to your unique account ID (e.g. tushu_{userId}_*). If another person logs in on the same phone, their workspace is completely segregated.'},{id:'priv-2',question:'Does TushuDiary sell or share my data?',answer:'Never. We do not sell, rent, or share your financial, diary, or personal information with advertising brokers, third-party analytics trackers, or data aggregators.'},{id:'priv-3',question:'Is my Password Vault encrypted?',answer:'Yes. Stored passwords and secret items inside your Password Vault are encrypted using client-side AES encryption algorithms before being committed to persistent storage.'}]},{category:'Backups & Restores',icon:n.FolderCheck,items:[{id:'bak-1',question:'How do I create a local backup of my ledger?',answer:'Go to Settings > Backup & Restore > Create Backup. The app generates a structured backup JSON package of your transactions, khata entries, categories, and notes.'},{id:'bak-2',question:'How does backup restore safeguard against data mixing?',answer:'During restoration, our restore engine verifies the user identity of every record. Foreign account keys, unauthorized tokens, and cross-user data entries are automatically filtered out to prevent data pollution.'},{id:'bak-3',question:'Where are my backup files saved?',answer:'Backups are stored inside your device\'s secure app document directory. You can also use the Share/Export option to save a copy to your Google Drive, iCloud, or external storage.'}]},{category:'Data Export & Deletion',icon:n.Trash2,items:[{id:'del-1',question:'How do I export my financial reports?',answer:'You can export your expenses and khata statements as Excel (.xlsx) spreadsheets or PDF reports via the Export buttons located in Khata and Reports sections.'},{id:'del-2',question:'How does the Recycle Bin work?',answer:'When you delete a transaction or note, it is initially moved to the Recycle Bin. You can review items here to either restore them back to your ledger or permanently erase them.'},{id:'del-3',question:'How do I permanently delete my account & cloud data?',answer:'You can request full account deletion and cloud record purging by navigating to Settings > Contact Admin or contacting our privacy team at privacy@codebytushu.com.'}]},{category:'Support & Help',icon:n.LifeBuoy,items:[{id:'sup-1',question:'How do I report a problem or request a feature?',answer:'Use the "Contact Admin" screen under Settings to submit feedback directly to the administrator, or reach out to our team at support@codebytushu.com.'},{id:'sup-2',question:'What if I forget my App Lock PIN?',answer:'If you have biometrics enabled, you can authenticate using your fingerprint or Face ID. Otherwise, you can log out and re-authenticate using your account password to reset the PIN.'}]}];function h({navigation:e}){var[c,h]=(0,t.useState)(null),[b,x]=(0,t.useState)(''),[f,w]=(0,t.useState)('All'),C=['All',...p.map(e=>e.category)],S=p.map(e=>{if('All'!==f&&e.category!==f)return null;var t=e.items.filter(e=>{var t=b.toLowerCase();return e.question.toLowerCase().includes(t)||e.answer.toLowerCase().includes(t)});return 0===t.length?null:{...e,items:t}}).filter(Boolean);return(0,u.jsxs)(o.SafeAreaView,{style:y.safeArea,children:[(0,u.jsx)(l.default,{}),(0,u.jsxs)(o.ScrollView,{contentContainerStyle:y.content,showsVerticalScrollIndicator:!1,children:[(0,u.jsxs)(o.View,{style:y.badgeCard,children:[(0,u.jsxs)(o.View,{style:y.badgeHeader,children:[(0,u.jsx)(n.HelpCircle,{size:22,color:s.C.gold}),(0,u.jsx)(o.Text,{style:y.badgeTitle,children:"TushuDiary Help Center"})]}),(0,u.jsx)(o.Text,{style:y.badgeSubtitle,children:"Find answers to security, backups, privacy, and app features"})]}),(0,u.jsxs)(o.View,{style:y.searchBar,children:[(0,u.jsx)(n.Search,{size:18,color:s.C.textMuted||'#8E8E93',style:y.searchIcon}),(0,u.jsx)(o.TextInput,{style:y.searchInput,placeholder:"Search questions or keywords...",placeholderTextColor:s.C.textMuted||'#8E8E93',underlineColorAndroid:"transparent",value:b,onChangeText:x,clearButtonMode:"while-editing"})]}),(0,u.jsx)(o.ScrollView,{horizontal:!0,showsHorizontalScrollIndicator:!1,contentContainerStyle:y.pillContainer,children:C.map((e,t)=>{var n=f===e;return(0,u.jsx)(o.TouchableOpacity,{style:[y.pill,n&&y.pillActive],onPress:()=>w(e),activeOpacity:.7,children:(0,u.jsx)(o.Text,{style:[y.pillText,n&&y.pillTextActive],children:e})},t)})}),0===